Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MotionPlanning1
        - /MotionPlanning1/Planning Request1
        - /MotionPlanning1/Planning Metrics1
        - /MotionPlanning1/Planned Path1
        - /wrist image1
        - /wrist image1/Topic1
        - /TF1/Frames1
        - /Surface Mesh Marker1/Topic1
        - /Surface path1/Topic1
      Splitter Ratio: 0.5338866114616394
    Tree Height: 420
  - Class: rviz_common/Help
    Name: Help
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: surface_gui/SurfacePanel
    Name: SurfacePanel
    acquisition:
      mesh_file: /home/nyquist/Documents/computed_surfaces/surface_curve_5.ply
      node: /cloud_merger_node
    current_tab: 1
    trajectory:
      deviation_x: 0
      deviation_y: 0
      deviation_z: 0.05
      execute_action: /execute_trajectory
      group_name: ur_robot
      joint_path_action: /compute_joint_path
      joint_states_topic: /joint_states
      keep_tool_orientation: true
      mesh_file: /home/nyquist/Documents/computed_surfaces/surface_sphere_3.ply
      mesh_frame: table
      planning_frame: open_tip_flipped
      raster_node: /raster_planner_node
      row_step: 0.005
      scaling_factor: 0.01
      time_parametrization_action: /compute_joint_trajectory
