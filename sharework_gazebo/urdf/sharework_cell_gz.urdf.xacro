<?xml version="1.0"?>
<!-- The Sharework cell in Gazebo (gz sim): the same description as the real
     cell, with the UR10e and the gripper driven by gz_ros2_control and the
     cameras rendered by Gazebo. -->
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="sharework_cell">

  <xacro:arg name="ur_type"                default="ur10e"/>
  <xacro:arg name="robot_name"             default="ur10e"/>
  <xacro:arg name="robot_tf_prefix"        default="ur10e_"/>
  <xacro:arg name="initial_positions_file" default="$(find sharework_cembre_description)/config/initial_positions.yaml"/>
  <!-- Controllers file the gz_ros2_control plugin loads. -->
  <xacro:arg name="simulation_controllers" default="$(find sharework_gazebo)/config/gz_controllers.yaml"/>
  <!-- Effort command net of gravity, as the UR direct torque control. -->
  <xacro:arg name="gravity_compensation"   default="true"/>
  <!-- Effort state net of gravity too (false: the torque Gazebo applies). -->
  <xacro:arg name="net_effort_state"       default="false"/>
  <!-- Render the ZED, the two fixed RealSense and the wrist one in Gazebo. -->
  <xacro:arg name="sim_cameras"            default="true"/>

  <xacro:property name="tf_prefix" value="$(arg robot_tf_prefix)"/>
  <xacro:property name="initial_positions" value="${xacro.load_yaml('$(arg initial_positions_file)')}"/>

  <!-- Cell, arm and gripper. No UR ros2_control block from the driver
       (generate_ros2_control_tag false): ours is below. The gripper gets
       gz_ros2_control/GazeboSimSystem from robotiq_description (sim_ignition). -->
  <xacro:include filename="$(find sharework_cembre_description)/urdf/sharework_cell.xacro"/>
  <xacro:sharework_cell
    fake_cameras="true"
    fake_robot="false"
    fake_gripper="false"
    ur_type="$(arg ur_type)"
    robot_name="$(arg robot_name)"
    robot_tf_prefix="${tf_prefix}"
    joint_limits_parameters_file="$(find sharework_cembre_description)/config/joint_limits.yaml"
    kinematics_parameters_file="$(find sharework_cembre_description)/config/default_kinematics.yaml"
    physical_parameters_file="$(find sharework_cembre_description)/config/physical_parameters.yaml"
    visual_parameters_file="$(find sharework_cembre_description)/config/visual_parameters.yaml"
    generate_ros2_control_tag="false"
    sim_ignition="true"
    initial_positions="${initial_positions}"
    use_tool_communication="false"
    robotiq_include_ros2_control="true"
    robotiq_use_socket_communication="false"/>

  <!-- UR10e joints in Gazebo, effort net of gravity. -->
  <xacro:include filename="$(find ur_description)/urdf/inc/ur_joint_control.xacro"/>
  <ros2_control name="$(arg robot_name)" type="system">
    <hardware>
      <plugin>sharework_gazebo/GravityCompensatedGazeboSystem</plugin>
      <param name="gravity_compensation">$(arg gravity_compensation)</param>
      <param name="net_effort_state">$(arg net_effort_state)</param>
    </hardware>
    <xacro:ur_joint_control_description tf_prefix="${tf_prefix}" initial_positions="${initial_positions}"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
    </plugin>
  </gazebo>

  <!-- ===================== Wrist RealSense ===================== -->
  <!-- Frames of the RealSense driver (camera "wrist") and the calibration of the
       inclined mounting of the real cell (cameras_tf.launch.py, ur10e_tool0 -> wrist_link):
       xyz 0.00648373 -0.0742079 0.0741869, quaternion 0.271469 -0.27528 0.644284 0.659866.
       The camera looks at the fingertips, 45 deg from the approach axis. -->
  <link name="wrist_link">
    <visual>
      <origin xyz="-0.0125 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.09 0.025"/></geometry>
      <material name="RealSenseGrey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <!-- No collision: wrist_camera_support (moving_parts.xacro) covers it -->
    <inertial>
      <mass value="0.072"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="${tf_prefix}tool0"/>
    <child link="wrist_link"/>
    <origin xyz="0.00648373 -0.0742079 0.0741869" rpy="0.00506333 -0.79391332 1.54477834"/>
  </joint>

  <!-- Frames the driver publishes on TF, as in realsense2_description (_d435):
       depth on wrist_link, color 15 mm along y. The aligned depth is in
       wrist_color_optical_frame, the point cloud in wrist_depth_optical_frame. -->
  <link name="wrist_depth_frame"/>
  <joint name="wrist_depth_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="wrist_depth_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="wrist_depth_optical_frame"/>
  <joint name="wrist_depth_optical_joint" type="fixed">
    <parent link="wrist_depth_frame"/>
    <child link="wrist_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
  <link name="wrist_color_frame"/>
  <joint name="wrist_color_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="wrist_color_frame"/>
    <origin xyz="0 0.015 0" rpy="0 0 0"/>
  </joint>
  <link name="wrist_color_optical_frame"/>
  <joint name="wrist_color_optical_joint" type="fixed">
    <parent link="wrist_color_frame"/>
    <child link="wrist_color_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <xacro:if value="$(arg sim_cameras)">
    <xacro:include filename="$(find sharework_gazebo)/urdf/sim_cameras.xacro"/>
    <xacro:sharework_sim_rgbd_camera name="zed" link="zed_camera_link" optical_frame="zed_camera_optical_frame"
                                     width="1280" height="720" hfov="1.91" rate="15"/>
    <xacro:sharework_sim_rgbd_camera name="rs1" link="rs1_camera_link" optical_frame="rs1_camera_optical_frame"
                                     width="848" height="480" hfov="1.51" rate="15"/>
    <xacro:sharework_sim_rgbd_camera name="rs2" link="rs2_camera_link" optical_frame="rs2_camera_optical_frame"
                                     width="848" height="480" hfov="1.51" rate="15"/>
    <!-- Wrist D435 as the driver runs it (wrist_realsense_params.yaml): color
         1280x720 (69 deg), depth 848x480 (87 deg), 30 Hz. Sensors on wrist_link
         (Gazebo drops the massless frames), placed at the color and depth frames.
         The color sensor's depth is the aligned depth. realsense_sim_adapter
         turns depth into 16UC1 mm, clips it and builds the point cloud. -->
    <xacro:sharework_sim_rgbd_camera name="wrist_color" topic="wrist/gz_color" link="wrist_link" optical_frame="wrist_color_optical_frame"
                                     width="1280" height="720" hfov="1.2043" rate="30" near="0.1" far="10.0"
                                     pose="0 0.015 0 0 0 0"/>
    <xacro:sharework_sim_rgbd_camera name="wrist_depth" topic="wrist/gz_depth" link="wrist_link" optical_frame="wrist_depth_optical_frame"
                                     width="848" height="480" hfov="1.5184" rate="30" near="0.1" far="10.0"/>
  </xacro:if>

</robot>
