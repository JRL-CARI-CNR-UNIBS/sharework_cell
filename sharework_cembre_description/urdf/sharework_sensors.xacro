<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="sharework_sensors">

  <xacro:include filename="$(find sharework_cembre_description)/urdf/zed_camera.xacro" />
  <xacro:include filename="$(find sharework_cembre_description)/urdf/realsense_camera.xacro" />

  <!-- ##################################################################
       Orchestratore dei sensori della cella. Ogni telecamera fisica
       e' una singola chiamata a macro: aggiungere/rimuovere una camera
       significa aggiungere/rimuovere una call qui sotto, senza toccare
       la logica fake/reale (che vive in zed_camera.xacro / realsense_camera.xacro)
       ################################################################## -->
  <xacro:macro name="sharework_sensors" params="
    zed_camera_name:='zed'
    zed_camera_model:='zed2'
    fake_cameras:=true
  ">

    <!-- ============================== ZED ============================== -->
    <xacro:sharework_zed_camera
            camera_name="${zed_camera_name}"
            camera_model="${zed_camera_model}"
            fake="${fake_cameras}"
            parent="world"
            origin_xyz="0.0937849 -0.929844 2.30862"
            origin_rpy="0.8165 0.9372 0.7201"
    />

    <!-- ========================= RealSense 1 ============================ -->
    <xacro:sharework_realsense_camera
            name="rs1"
            fake="${fake_cameras}"
            parent="world"
            origin_xyz="0.845205 1.15052 2.57347"
            origin_rpy="0.0773 0.773 -1.553"
            realsense_model="d435"
    />

    <!-- ========================= RealSense 2 ============================ -->
    <xacro:sharework_realsense_camera
            name="rs2"
            fake="${fake_cameras}"
            parent="world"
            origin_xyz="0.649999 -1.16584 2.63428"
            origin_rpy="-0.0696 0.795 1.502"
            realsense_model="d435i"
    />

    <!-- Per aggiungere una terza RealSense basta una call in piu', es.:
    <xacro:sharework_realsense_camera
            name="rs3"
            fake="${fake_cameras}"
            parent="world"
            origin_xyz="x y z"
            origin_rpy="r p y"
    />
    -->

  </xacro:macro>
</robot>
